
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
.beads/*.jsonl
# bd 1.2.1 workspace gate file, written beside .beads at the repo root
/.beads.gate.lock

# Oracle fixtures are synthetic Picasa db files, not Dolt artifacts
!fixtures/oracle/**/*.db

# Local media/research cache (rebuild with scripts/fetch-videos.sh)
/cache/

# Agent worktrees (git worktrees created by Claude Code; never tracked)
.claude/worktrees/

# Local env/config (may reference private data paths)
.env
__pycache__/

# PyInstaller packaging (fauxcasa-ncv) build outputs + CI smoke artifacts;
# the bundle is rebuilt in CI / via tracer/fauxcasa-tracer.spec
/build/
/dist/
/ci-library/
/ci-cache/
/gui-cache/
/frozen-ci.png
/gui-ci.png
